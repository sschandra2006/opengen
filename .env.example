# OpenGen Environment Configuration Template

# -----------------------------------------------------------------------------
# AI Provider API Keys (Bring Your Own Key - BYOK)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
OPENROUTER_API_KEY=
RECRAFT_API_KEY=

# -----------------------------------------------------------------------------
# Default Models & Fallback Hierarchy
# -----------------------------------------------------------------------------
OPENGEN_DEFAULT_PRIMARY_MODEL=gemini/gemini-2.5-flash
OPENGEN_DEFAULT_FAST_MODEL=openai/gpt-4o-mini
OPENGEN_DEFAULT_LOCAL_MODEL=ollama/qwen3:8b

# -----------------------------------------------------------------------------
# Asynchronous Task Queue & Cache
# -----------------------------------------------------------------------------
# Queue backend: 'sqlite' (zero-daemon default) or 'redis'
OPENGEN_QUEUE_BACKEND=sqlite
OPENGEN_REDIS_URL=redis://127.0.0.1:6379/0

# Storage directories
OPENGEN_CACHE_DIR=./cache
OPENGEN_OUTPUT_DIR=./output
OPENGEN_UPLOAD_DIR=./data/uploads

# -----------------------------------------------------------------------------
# Server Network Settings
# -----------------------------------------------------------------------------
OPENGEN_SERVER_HOST=127.0.0.1
OPENGEN_SERVER_PORT=8000
